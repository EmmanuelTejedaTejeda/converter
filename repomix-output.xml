    // Visual Preview Updates
    function applyVisualTransform(imgEl) {
        if (!imgEl) return;
        imgEl.style.transition = 'transform 0.25s ease';
        imgEl.style.transform = `rotate(${currentRotation}deg) scale(${flipH ? -1 : 1}, ${flipV ? -1 : 1})`;
