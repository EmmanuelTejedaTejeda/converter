    cursor: move;
    z-index: 10;
    box-shadow: 0 0 10px rgba(244, 114, 182, 0.5);
    touch-action: none; /* Prevent scrolling when dragging on mobile */
}

.watermark-resize-handle {
    position: absolute;
    bottom: -10px;
    right: -10px;
    width: 20px;
    height: 20px;
    background: #f472b6;
    border: 2px solid #fff;
    cursor: se-resize;
    border-radius: 50%;
