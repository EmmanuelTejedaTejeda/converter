                        word-break: break-all;
                    }
                    tr:last-child td {
                        border-bottom: none;
                    }
                    tr:nth-child(even) td {
                        background: #1e293b;
                    }
                    tr:hover td {
                        background: #0f172a;
                    }
                    a {
                        color: #38bdf8;
                        text-decoration: none;
                        font-weight: 500;
                        transition: color 0.2s ease;
                    }
                    a:hover {
                        color: #7dd3fc;
