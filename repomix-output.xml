                a.href = f.convertedBlobUrl;
                a.download = f.convertedBlobName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                showThankYouModal();
            }
        });
    }

    function showThankYouModal() {
        if (thankYouModal) thankYouModal.classList.remove('hidden');
