/* ==========================================================================
   Design System & Variables
   ========================================================================== */
:root {
    /* Fonts */
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;

    /* Common Colors */
    --white: #ffffff;
    --black: #000000;
    --danger: #ef4444;
    --danger-bg: rgba(239, 68, 68, 0.05);

    /* Transitions */
    --transition-fast: 0.15s ease-out;
    --transition-normal: 0.25s ease-out;
    --transition-slow: 0.4s ease-out;
    --transition-spring: 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    
    /* Shadows - Disabled for Swiss Flat design */
    --shadow-sm: none;
    --shadow-md: none;
    --shadow-lg: none;
}

/* Light Theme Variables */
body.light-theme {
    --bg-primary: #f5f3ff; /* Soft lavender-white */
    --bg-secondary: #ece9fc; /* Muted lavender */
    --text-primary: #1e1b4b; /* Deep indigo text */
    --text-secondary: #4c1d95; /* Indigo-purple subtext */
    --text-muted: #6d28d9; /* Darker violet details for contrast */
    
    --accent-primary: #6d28d9; /* Darker violet for contrast */
    --accent-hover: #c2185b; /* Darker rose-pink for contrast */
    --accent-gradient: linear-gradient(135deg, #6d28d9, #c2185b);
    --accent-soft: rgba(109, 40, 217, 0.08);
    --accent-glow: rgba(109, 40, 217, 0.2);
    
    --card-bg: rgba(255, 255, 255, 0.75);
    --card-border: rgba(109, 40, 217, 0.22);
    --card-shadow: 0 20px 40px -15px rgba(109, 40, 217, 0.12);
    --slider-track: rgba(109, 40, 217, 0.18);
    
    --dropzone-border: rgba(109, 40, 217, 0.45);
    --dropzone-border-hover: #c2185b;
    --dropzone-bg: rgba(255, 255, 255, 0.45);
    --dropzone-bg-hover: rgba(109, 40, 217, 0.03);

    --header-bg: rgba(255, 255, 255, 0.88);
    --header-border: rgba(109, 40, 217, 0.18);
    
    --dropdown-bg: #ffffff;
    --dropdown-shadow: 0 15px 35px rgba(109, 40, 217, 0.16), 0 5px 15px rgba(0, 0, 0, 0.08);
    
    --blob-color-1: rgba(109, 40, 217, 0.22);
    --blob-color-2: rgba(194, 24, 91, 0.18);
    
    /* Categorías de herramientas */
    --color-conversion: #2563eb;
    --color-conversion-glow: rgba(37, 99, 235, 0.12);
    --color-conversion-bg: rgba(37, 99, 235, 0.05);

    --color-optimization: #059669;
    --color-optimization-glow: rgba(5, 150, 105, 0.12);
    --color-optimization-bg: rgba(5, 150, 105, 0.05);

    --color-edit: #db2777;
    --color-edit-glow: rgba(219, 39, 119, 0.12);
    --color-edit-bg: rgba(219, 39, 119, 0.05);

    --color-doc: #dc2626;
    --color-doc-glow: rgba(220, 38, 38, 0.12);
    --color-doc-bg: rgba(220, 38, 38, 0.05);
}

/* Dark Theme Variables */
body.dark-theme {
    --bg-primary: #030712; /* Deep Obsidian Black */
    --bg-secondary: #0b0f19; /* Deep Slate-Indigo */
    --text-primary: #f9fafb;
    --text-secondary: #9ca3af;
    --text-muted: #9ca3af; /* Lightened from #6b7280 for WCAG AA contrast */
    
    --accent-primary: #a78bfa; /* Glowing Lavender */
    --accent-hover: #f472b6; /* Glowing Rose */
    --accent-gradient: linear-gradient(135deg, #a78bfa, #f472b6);
    --accent-soft: rgba(167, 139, 250, 0.1);
    --accent-glow: rgba(167, 139, 250, 0.3);
    
    --card-bg: rgba(11, 15, 25, 0.65);
    --card-border: rgba(255, 255, 255, 0.16);
    --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    --slider-track: rgba(255, 255, 255, 0.18);
    
    --dropzone-border: rgba(255, 255, 255, 0.25);
    --dropzone-border-hover: #a78bfa;
    --dropzone-bg: rgba(11, 15, 25, 0.35);
    --dropzone-bg-hover: rgba(167, 139, 250, 0.03);

    --header-bg: rgba(3, 7, 18, 0.88);
    --header-border: rgba(255, 255, 255, 0.15);
    
    --dropdown-bg: #0c101d;
    --dropdown-shadow: 0 20px 45px rgba(0, 0, 0, 0.65), 0 5px 20px rgba(0, 0, 0, 0.35);
    
    --blob-color-1: rgba(139, 92, 246, 0.28);
    --blob-color-2: rgba(236, 72, 153, 0.2);
    
    /* Categorías de herramientas */
    --color-conversion: #60a5fa;
    --color-conversion-glow: rgba(96, 165, 250, 0.25);
    --color-conversion-bg: rgba(96, 165, 250, 0.08);

    --color-optimization: #34d399;
    --color-optimization-glow: rgba(52, 211, 153, 0.25);
    --color-optimization-bg: rgba(52, 211, 153, 0.08);

    --color-edit: #f472b6;
    --color-edit-glow: rgba(244, 114, 182, 0.25);
    --color-edit-bg: rgba(244, 114, 182, 0.08);

    --color-doc: #f87171;
    --color-doc-glow: rgba(248, 113, 113, 0.25);
    --color-doc-bg: rgba(248, 113, 113, 0.08);
}

/* ==========================================================================
   Base Elements
   ========================================================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.hidden {
    display: none !important;
}

body {
    font-family: var(--font-body);
    background-color: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
    transition: background-color var(--transition-normal), color var(--transition-normal);
}

/* Dynamic background blobs */
.blob-bg {
    position: absolute;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    z-index: -1;
    filter: blur(140px);
    pointer-events: none;
    transition: background var(--transition-slow);
    animation-duration: 25s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
}

.blob-bg-1 {
    top: -200px;
    left: -100px;
    background: var(--blob-color-1);
    animation-name: float-blob-1;
}

.blob-bg-2 {
    bottom: -150px;
    right: -150px;
    background: var(--blob-color-2);
    animation-name: float-blob-2;
}

@keyframes float-blob-1 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
    }
    33% {
        transform: translate(60px, -50px) scale(1.1);
    }
    66% {
        transform: translate(-30px, 40px) scale(0.9);
    }
}

@keyframes float-blob-2 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
    }
    33% {
        transform: translate(-50px, 30px) scale(0.95);
    }
    66% {
        transform: translate(40px, -50px) scale(1.15);
    }
}

/* ==========================================================================
   Header Component
   ========================================================================== */
.app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
    text-decoration: none;
}

.logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-gradient);
    color: var(--white);
    box-shadow: 0 4px 15px var(--accent-glow);
    transition: transform var(--transition-spring);
}

.logo:hover .logo-icon {
    transform: rotate(-10deg) scale(1.08);
}

.logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

/* Global Navigation Menu */
.header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nav-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
}

.nav-link:hover {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    border-color: var(--card-border);
}

.nav-link.active {
    color: var(--white);
    background: var(--accent-gradient);
    box-shadow: 0 2px 10px var(--accent-glow);
}

@media (max-width: 900px) {
    .header-container {
        flex-wrap: wrap;
        padding: 0.75rem 1rem;
        gap: 0.75rem;
    }
    
    .logo {
        order: 1;
    }
    
    .header-actions {
        order: 2;
    }
    
    .header-nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
        white-space: nowrap;
        padding: 0.25rem 0;
        justify-content: flex-start;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
    }
    
    .header-nav::-webkit-scrollbar {
        display: none; /* Chrome, Safari and Opera */
    }
}

.stats-counter {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--accent-soft);
    border: 1px solid var(--accent-glow);
    padding: 0.4rem 0.8rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-primary);
    cursor: default;
    user-select: none;
    transition: transform var(--transition-spring);
}

.stats-counter.bump {
    transform: scale(1.2) rotate(4deg);
}

.sound-toggle, .theme-toggle {
    background: none;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-primary);
    transition: all var(--transition-fast);
    background-color: var(--card-bg);
}

.sound-toggle:hover, .theme-toggle:hover {
    transform: translateY(-2px);
    border-color: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-glow);
}

.sound-toggle:active, .theme-toggle:active {
    transform: scale(0.92);
}

.sound-toggle svg, .theme-toggle svg {
    transition: transform var(--transition-fast);
}

body.dark-theme .sun-icon {
    display: block;
}
body.dark-theme .moon-icon {
    display: none;
}
body.light-theme .sun-icon {
    display: none;
}
body.light-theme .moon-icon {
    display: block;
}

/* ==========================================================================
   Main App Content
   ========================================================================== */
.app-main {
    flex: 1;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 5rem;
    position: relative;
    z-index: 10;
}

/* Vertically center the converter card and hero inside the viewport */
.converter-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 72px - 80px); /* 100vh minus header and footer */
    gap: 1.75rem;
    box-sizing: border-box;
    padding: 1.5rem 0;
}

/* Hero Section */
.hero-section {
    text-align: center;
    animation: fadeInDown 0.8s ease;
}

.hero-title {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
}

/* Main Interactive Card */
.converter-card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: border-color var(--transition-fast);
}

/* Drag and Drop Zone */
.drop-zone {
    border: 1px dashed var(--dropzone-border);
    border-radius: 4px;
    padding: 2.75rem 2rem;
    text-align: center;
    background-color: var(--dropzone-bg);
    position: relative;
    cursor: pointer;
    transition: all var(--transition-fast);
    overflow: hidden;
}

.drop-zone:hover, .drop-zone.dragover {
    border-color: var(--dropzone-border-hover);
    background-color: var(--dropzone-bg-hover);
    box-shadow: 0 0 25px var(--accent-glow);
    transform: scale(0.99);
}

.file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
}

.drop-zone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    pointer-events: none;
}

.drop-icon {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    transition: all var(--transition-normal);
}

.drop-zone:hover .drop-icon, .drop-zone.dragover .drop-icon {
    transform: scale(1.1) rotate(5deg);
    background-color: var(--accent-primary);
    color: var(--white);
    box-shadow: 0 8px 24px var(--accent-glow);
}

.drop-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
}

.drop-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
}

.drop-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    margin-top: 0.5rem;
}

/* Privacy Notice Banner */
.privacy-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background-color: var(--accent-soft);
    border: 1px solid var(--accent-glow);
    color: var(--accent-primary);
    font-size: 0.875rem;
    line-height: 1.4;
}

.privacy-notice svg {
    flex-shrink: 0;
}

/* Suggestion Banner (e.g., Crop link) */
.suggestion-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(168, 85, 247, 0.08);
    border: 1px dashed var(--accent-primary);
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-top: 1rem;
    transition: all 0.2s ease;
}

.suggestion-banner:hover {
    background: rgba(168, 85, 247, 0.15);
    transform: translateY(-1px);
}

.suggestion-banner-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
}

.suggestion-banner-action {
    color: var(--accent-primary);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
}

@media (max-width: 600px) {
    .suggestion-banner {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
}

/* Dynamic File List Container */
.file-list-container {
    border-top: 1px solid var(--card-border);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: fadeIn 0.4s ease;
}

.file-list-container.hidden {
    display: none;
}

.list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.list-header h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
}

.list-actions {
    display: flex;
    gap: 0.75rem;
}

/* Buttons Styling - Swiss High Contrast */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.65rem 1.25rem;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
}

.btn-primary {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
}

.btn-primary:hover {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--white);
}

.btn:active, .btn-primary:active {
    transform: translateY(1px);
}

.btn-secondary {
    background-color: transparent;
    border-color: var(--card-border);
    color: var(--text-primary);
}

.btn-secondary:hover {
    border-color: var(--text-primary);
    background-color: var(--bg-secondary);
}

.btn-danger-outline {
    background: transparent;
    border-color: var(--card-border);
    color: var(--danger);
}

.btn-danger-outline:hover {
    background-color: var(--danger);
    border-color: var(--danger);
    color: var(--white);
}

.btn[disabled], button.btn-secondary[disabled] {
    opacity: 0.3;
    pointer-events: none;
}

/* File list content grid */
.file-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-height: 400px;
    overflow-y: auto;
    padding-right: 0.25rem;
}

/* Custom Scrollbar for list */
.file-list::-webkit-scrollbar {
    width: 6px;
}
.file-list::-webkit-scrollbar-track {
    background: transparent;
}
.file-list::-webkit-scrollbar-thumb {
    background: var(--card-border);
    border-radius: 2px;
}
.file-list::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary);
}

/* File Card Component */
.file-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    transition: border-color var(--transition-fast);
    animation: slideIn 0.25s ease-out;
}

.file-card:hover {
    border-color: var(--text-primary);
}

.file-info-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0; /* allows overflow truncation inside flex child */
    flex: 1;
}

/* Preview Thumbnail */
.file-preview-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--card-border);
    position: relative;
    flex-shrink: 0;
    border: 1px solid var(--card-border);
}

.file-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.file-preview-fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
}

.file-preview.hidden {
    display: none;
}

.file-preview.hidden + .file-preview-fallback {
    display: flex;
}

.file-preview:not(.hidden) + .file-preview-fallback {
    display: none;
}

/* Details */
.file-details {
    min-width: 0; /* truncate */
}

.file-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.25rem;
}

.file-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
}

/* Badges and actions container */
.file-status-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
}

/* Status Badges - Text inside brackets style */
.status-badge {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0;
    border-radius: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.badge-pending::before { content: '['; }
.badge-pending::after { content: ']'; }
.badge-pending { color: var(--text-secondary); }

.badge-converting::before { content: '['; }
.badge-converting::after { content: ']'; }
.badge-converting { color: var(--accent-primary); }

.badge-done::before { content: '['; }
.badge-done::after { content: ']'; }
.badge-done { color: var(--accent-primary); }

.badge-error::before { content: '['; }
.badge-error::after { content: ']'; }
.badge-error { color: var(--danger); }

/* Progress bar inside card */
.file-progress-wrapper {
    width: 80px;
    flex-shrink: 0;
}

.file-progress-wrapper.hidden {
    display: none;
}

.progress-bar {
    height: 2px;
    width: 100%;
    background-color: var(--card-border);
    border-radius: 0;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: var(--accent-primary);
    border-radius: 0;
    width: 0%;
    transition: width 0.2s ease-out;
}

/* Action Buttons inside Card */
.file-actions {
    display: flex;
    gap: 0.35rem;
}

.btn-icon {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.btn-icon:hover {
    color: var(--text-primary);
    background-color: var(--card-border);
}

.btn-convert-text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: transparent;
    border: 1px solid var(--text-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.btn-convert-text:hover {
    background-color: var(--text-primary);
    color: var(--bg-primary);
}

.btn-download-text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
}

.btn-download-text:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--white);
    transform: translateY(-1px);
}

.btn-action-remove:hover {
    color: var(--danger);
    background-color: var(--danger-bg);
}

.btn-action-convert.hidden, .btn-action-download.hidden, .btn-icon.hidden {
    display: none !important;
}

/* ==========================================================================
   Features Section
   ========================================================================== */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    padding-bottom: 3rem;
}

.feature-card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    padding: 1.75rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: border-color var(--transition-fast);
}

.feature-card:hover {
    border-color: var(--text-primary);
}

.feature-icon {
    color: var(--accent-primary);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.feature-card h3 {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.feature-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
}

/* ==========================================================================
   Footer Component
   ========================================================================== */
.app-footer-bar {
    padding: 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-top: 1px solid var(--header-border);
    background-color: var(--header-bg);
    margin-top: auto;
}

/* ==========================================================================
   Animations
   ========================================================================== */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Mobile & Tablet Adjustments */
@media (max-width: 640px) {
    /* Header optimization */
    .header-container {
        padding: 0.75rem 1rem;
    }
    .logo-text {
        font-size: 1.25rem;
    }
    .logo-icon {
        width: 32px;
        height: 32px;
    }
    .header-actions {
        gap: 0.5rem;
    }


    /* Main layout spacing */
    .app-main {
        padding: 1rem 0.75rem;
        gap: 2.5rem;
    }
    .hero-title {
        font-size: 2.15rem;
    }
    .converter-card {
        padding: 1.25rem 1rem;
        gap: 1.25rem;
    }
    .drop-zone {
        padding: 2.25rem 1rem;
    }

    /* File lists and global action buttons */
    .list-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
    }
    .list-actions {
        width: 100%;
        flex-direction: column;
        gap: 0.5rem;
    }
    .list-actions .btn {
        width: 100%;
        padding: 0.6rem;
    }

    /* File Card inside list */
    .file-card {
        flex-direction: column;
        align-items: stretch;
        gap: 0.85rem;
        padding: 0.85rem;
    }
    .file-info-group {
        width: 100%;
    }
    .file-preview-wrapper {
        width: 42px;
        height: 42px;
    }
    .file-name {
        font-size: 0.85rem;
    }
    .file-meta {
        font-size: 0.75rem;
    }
    .file-status-group {
        justify-content: space-between;
        width: 100%;
        gap: 1rem;
        border-top: 1px solid var(--card-border);
        padding-top: 0.75rem;
    }

    /* Modal dialog */
    .modal-card {
        padding: 1.75rem 1.25rem;
        width: 92%;
    }
    .modal-title {
        font-size: 1.35rem;
    }
    .modal-ad-box {
        padding: 1rem;
        gap: 0.35rem;
    }
    .modal-ad-box h4 {
        font-size: 0.95rem;
    }
    .modal-ad-box p {
        font-size: 0.8rem;
    }
}

/* Confetti Particles styles */
.confetti-particle {
    position: absolute;
    pointer-events: none;
    z-index: 9999;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    animation: confetti-fall 1s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
}

@keyframes confetti-fall {
    0% {
        transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
        opacity: 1;
    }
    100% {
        transform: translate3d(var(--x), var(--y), 0) rotate(var(--r), var(--r2), var(--r3)) scale(0.2);
        opacity: 0;
    }
}

/* Card Glow Pulse */
.file-card.success-pulse {
    border-color: var(--accent-primary) !important;
}

/* ==========================================================================
   Minimalist Integrated Ad (Swiss Editorial Style)
   ========================================================================== */
.ad-container-minimal {
    margin-top: 0.5rem;
    background-color: var(--card-bg);
    border: 1px dashed var(--card-border);
    border-radius: 8px;
    padding: 0.85rem 1.25rem;
    transition: all var(--transition-fast);
}

.ad-container-minimal:hover {
    border-color: var(--accent-primary);
    background-color: var(--accent-soft);
}

.ad-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.85rem;
}

.ad-badge {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
}

.ad-badge::before { content: '['; }
.ad-badge::after { content: ']'; }

.ad-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex: 1;
    flex-wrap: wrap;
}

.ad-text {
    color: var(--text-secondary);
    line-height: 1.4;
}

.ad-cta {
    font-weight: 700;
    color: var(--accent-primary);
    white-space: nowrap;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
}

@media (max-width: 640px) {
    .ad-link {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
    .ad-body {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        width: 100%;
    }
    .ad-cta {
        align-self: flex-end;
    }
}

/* ==========================================================================
   Post-Download Modal Styles
   ========================================================================== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 1;
    transition: opacity var(--transition-normal);
}

.modal-overlay.hidden {
    opacity: 0;
    pointer-events: none;
}

.modal-card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    max-width: 480px;
    width: 90%;
    padding: 2.25rem 2rem;
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    animation: slideIn 0.3s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.75rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--transition-fast);
}

.modal-close-btn:hover {
    color: var(--text-primary);
}

.modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
}

.modal-icon {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
}

.modal-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
}

.modal-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
}

.modal-ad-box {
    width: 100%;
    background-color: var(--bg-secondary);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 1.25rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.modal-ad-tag {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.modal-ad-tag::before { content: '['; }
.modal-ad-tag::after { content: ']'; }

.modal-ad-box h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
}

.modal-ad-box p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin-bottom: 0.5rem;
}

.btn-block {
    width: 100%;
    text-align: center;
}

/* ==========================================================================
   Resources Section (Affiliates)
   ========================================================================== */
.resources-section {
    padding-bottom: 2rem;
    border-top: 1px solid var(--card-border);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.resources-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
}

.resources-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
}

.resource-item {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    padding: 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all var(--transition-fast);
}

.resource-item:hover {
    border-color: var(--text-primary);
    transform: translateY(-1px);
}

.resource-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
}

.resource-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
}

/* Footer Improvements */
.footer-container {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.footer-support-link {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color var(--transition-fast);
}

.footer-support-link:hover {
    color: var(--accent-hover);
}

@media (max-width: 640px) {
    .footer-container {
        flex-direction: column;
        text-align: center;
        gap: 0.75rem;
    }
}

/* ==========================================================================
   Tools Hub Page Styles (Swiss Editorial Grid)
   ========================================================================== */

/* ==========================================================================
   Tools Hub Page Styles (Swiss Editorial Grid - Modern Overhaul)
   ========================================================================== */

.tools-directory {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.directory-header {
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.directory-header h2 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

/* Filter Tabs Styling */
.filter-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem auto 2.5rem auto;
    padding: 0.375rem;
    background: var(--bg-secondary);
    border-radius: 30px;
    width: fit-content;
    border: 1px solid var(--card-border);
    backdrop-filter: blur(8px);
}

.filter-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 25px;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: var(--font-body);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.filter-btn:hover {
    color: var(--text-primary);
}

.filter-btn.active {
    background: var(--accent-primary);
    color: var(--white);
    box-shadow: 0 4px 12px var(--accent-glow);
}

.tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
    transition: all 0.3s ease;
}

/* Category Specific styles for Cards */
.tool-card-item.category-conversion {
    --card-accent-color: var(--color-conversion);
    --card-accent-glow: var(--color-conversion-glow);
    --card-accent-bg: var(--color-conversion-bg);
}
.tool-card-item.category-optimization {
    --card-accent-color: var(--color-optimization);
    --card-accent-glow: var(--color-optimization-glow);
    --card-accent-bg: var(--color-optimization-bg);
}
.tool-card-item.category-edit {
    --card-accent-color: var(--color-edit);
    --card-accent-glow: var(--color-edit-glow);
    --card-accent-bg: var(--color-edit-bg);
}
.tool-card-item.category-doc {
    --card-accent-color: var(--color-doc);
    --card-accent-glow: var(--color-doc-glow);
    --card-accent-bg: var(--color-doc-bg);
}

.tool-card-item {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.3s var(--transition-spring), 
                border-color 0.3s var(--transition-spring), 
                box-shadow 0.3s var(--transition-spring),
                opacity 0.25s ease,
                visibility 0.25s ease;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
}

a.tool-card-item {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
}

.tool-card-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background-color: var(--card-accent-color);
    opacity: 0.8;
}

.tool-card-item:hover {
    transform: translateY(-4px) scale(1.01);
    border-color: var(--card-accent-color);
    box-shadow: 0 12px 30px var(--card-accent-glow);
}

/* Card Header with Icon */
.tool-card-header-v2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.tool-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background-color: var(--card-accent-bg);
    color: var(--card-accent-color);
    transition: transform 0.3s var(--transition-spring), background-color 0.3s var(--transition-spring), color 0.3s var(--transition-spring);
}

.tool-card-item:hover .tool-icon-wrapper {
    transform: scale(1.1) rotate(4deg);
    background-color: var(--card-accent-color);
    color: var(--white);
}

.tool-icon-wrapper svg {
    width: 22px;
    height: 22px;
    stroke-width: 2px;
}

.badge-container {
    display: flex;
    gap: 0.4rem;
    align-items: center;
}

.badge-new {
    background: var(--accent-gradient);
    color: var(--white);
    padding: 0.2rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 20px;
    letter-spacing: 0.05em;
}

.tool-status-dot {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
}

.tool-status-dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981; /* green dot */
}

/* Clean Info Styles */
.tool-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.tool-info h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
}

.tool-info p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
}

/* Filtering classes */
.tool-card-item.filter-hidden {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
    position: absolute;
    width: 0;
    height: 0;
    padding: 0;
    margin: 0;
    border: none;
    overflow: hidden;
}

.tool-card-item.filter-hidden::before {
    display: none;
}

.disabled-card {
    opacity: 0.5;
    background-color: transparent;
    border-style: dashed;
    cursor: not-allowed;
}

/* ==========================================================================
   Compressor Settings Panel (Swiss Editorial Style)
   ========================================================================== */
.compressor-settings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

@media (max-width: 768px) {
    .compressor-settings {
        grid-template-columns: 1fr;
        gap: 1.25rem;
        padding: 1.25rem;
    }
}

.converter-card .compressor-settings {
    border: none;
    background: transparent;
    padding: 1.5rem 0 0 0;
    margin-top: 1.5rem;
    margin-bottom: 0;
    border-top: 1px solid var(--card-border);
    border-radius: 0;
}

.setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.setting-item label {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-primary);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#quality-badge {
    background-color: var(--accent-primary);
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-body);
}

.slider-container {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.slider-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
}

.quality-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: var(--slider-track);
    outline: none;
    transition: all 0.15s ease-in-out;
    border: 1px solid var(--card-border);
}

.quality-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-primary);
    cursor: pointer;
    transition: transform 0.1s ease-in-out, background-color 0.15s ease;
    border: 2px solid var(--bg-primary);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.quality-slider::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-primary);
    cursor: pointer;
    transition: transform 0.1s ease-in-out, background-color 0.15s ease;
    border: 2px solid var(--bg-primary);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.quality-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background-color: var(--accent-hover);
}

.quality-slider::-moz-range-thumb:hover {
    transform: scale(1.15);
    background-color: var(--accent-hover);
}

.quality-slider::-moz-range-thumb:hover {
    transform: scale(1.2);
}

.format-select {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    color: var(--text-primary);
    padding: 0.6rem 1rem;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    cursor: pointer;
    transition: border-color var(--transition-fast);
}

.format-select:focus {
    border-color: var(--text-primary);
}

/* ==========================================================================
   SEO On-Page Content Section (Swiss Editorial Layout)
   ========================================================================== */
.seo-content-section {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding: 3rem 0;
    border-top: 1px solid var(--card-border);
}

.seo-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 720px; /* Ancho de lectura óptimo */
}

.seo-block h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.25;
}

.seo-block p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.seo-steps-list {
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.seo-steps-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.seo-steps-list li strong {
    color: var(--text-primary);
}

.faq-item {
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.faq-item h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
}

.faq-item p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-secondary);
}

/* Warning action buttons for PNG warnings in Compressor */
.warning-action-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    color: var(--accent-primary);
    text-decoration: underline;
    cursor: pointer;
    transition: color var(--transition-fast) ease;
}

.warning-action-btn:hover {
    color: var(--accent-hover);
}

.file-size-saving.saving-neutral {
    color: var(--text-secondary);
    font-weight: normal;
    opacity: 0.85;
}

/* PDF generator layout options and reordering styles */
.reorder-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex-shrink: 0;
}

.btn-reorder {
    background: none;
    border: 1px solid var(--card-border);
    color: var(--text-secondary);
    width: 26px;
    height: 26px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast) ease;
}

.btn-reorder:hover:not(:disabled) {
    border-color: var(--accent-primary);
    color: var(--text-primary);
    background-color: var(--accent-soft);
}

.btn-reorder:disabled {
    opacity: 0.2;
    cursor: not-allowed;
}

.btn-reorder svg {
    width: 12px;
    height: 12px;
}


/* ==========================================================================
   Header Component & Navigation Dropdowns (Modernized)
   ========================================================================== */
.app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: background-color var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative; /* Acts as the anchor for the full-width mega menu */
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
    text-decoration: none;
}

.logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-gradient);
    color: var(--white);
    box-shadow: 0 4px 15px var(--accent-glow);
    transition: transform var(--transition-spring);
}

.logo:hover .logo-icon {
    transform: rotate(-10deg) scale(1.08);
}

.logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

/* ============================
   Dropdowns Common Styling
   ============================ */
.lang-dropdown {
    position: relative;
    display: inline-block;
}

.nav-dropdown {
    position: static; /* Allows the mega menu to escape and anchor to .header-container */
    display: inline-block;
}

.nav-dropdown-trigger, .lang-dropdown-trigger {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    padding: 0.5rem 0.85rem;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
}

.nav-dropdown-trigger:hover, .lang-dropdown-trigger:hover {
    color: var(--text-primary);
    background-color: var(--accent-soft);
    border-color: var(--header-border);
}

.dropdown-arrow {
    transition: transform var(--transition-normal);
}

.nav-dropdown:hover .dropdown-arrow, .lang-dropdown:hover .dropdown-arrow {
    transform: rotate(180deg);
}

/* ============================
   Mega Menu for Tools
   ============================ */
.nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 2rem; /* Aligns with header-container padding */
    right: 2rem; /* Spans the full width of the container minus padding */
    width: auto;
    transform: translateY(10px);
    opacity: 0;
    visibility: hidden;
    background-color: var(--dropdown-bg);
    border: 1px solid var(--header-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: var(--dropdown-shadow);
    display: flex;
    gap: 2.5rem;
    z-index: 1000;
    transition: transform var(--transition-normal), opacity var(--transition-normal), visibility var(--transition-normal);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.nav-dropdown:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown-category {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
}

.dropdown-category h4 {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent-soft);
    padding-bottom: 0.25rem;
}

.dropdown-category a {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    background-color: var(--card-bg);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all var(--transition-fast);
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.dropdown-category a svg {
    color: var(--accent-primary);
    opacity: 0.8;
    transition: all var(--transition-fast);
}

.dropdown-category a:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background-color: var(--accent-soft);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.dropdown-category a:hover svg {
    opacity: 1;
    transform: scale(1.15);
}

/* ============================
   Language Dropdown Menu
   ============================ */
.lang-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    transform: translateY(10px);
    opacity: 0;
    visibility: hidden;
    background-color: var(--dropdown-bg);
    border: 1px solid var(--header-border);
    border-radius: 12px;
    padding: 0.5rem;
    box-shadow: var(--dropdown-shadow);
    display: flex;
    flex-direction: column;
    min-width: 140px;
    z-index: 1000;
    transition: transform var(--transition-normal), opacity var(--transition-normal), visibility var(--transition-normal);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.lang-dropdown:hover .lang-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}
.lang-option {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
}

.lang-option:hover {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
}

.lang-option.active {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    font-weight: 700;
}

.lang-option .flag {
    font-size: 1.1rem;
}

/* ============================
   Theme Toggle Button Override
   ============================ */
.theme-toggle {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.theme-toggle:hover {
    color: var(--text-primary);
    background-color: var(--accent-soft);
    border-color: var(--header-border);
    transform: scale(1.05);
}

.sun-icon {
    display: none;
}
.moon-icon {
    display: block;
}
body.light-theme .sun-icon {
    display: block;
}
body.light-theme .moon-icon {
    display: none;
}

/* ============================
   Hamburger Button (Mobile Only)
   ============================ */
.hamburger-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1100;
}

.hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: all var(--transition-normal);
}

/* ============================
   Mobile Navigation Drawer
   ============================ */
.mobile-nav-drawer {
    position: fixed;
    top: 72px; /* Adjust to header height */
    height: calc(100vh - 72px);
    left: 0;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--header-border);
    z-index: 9999;
    isolation: isolate; /* Prevents text bleeding through */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: transform var(--transition-normal), opacity var(--transition-normal), visibility var(--transition-normal);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1.5rem 2rem 4rem 2rem;
}

body.mobile-menu-open {
    overflow: hidden;
}

body.mobile-menu-open .mobile-nav-drawer {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

/* Hamburger animations */
body.mobile-menu-open .hamburger-menu-btn .hamburger-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}

body.mobile-menu-open .hamburger-menu-btn .hamburger-bar:nth-child(2) {
    opacity: 0;
}

body.mobile-menu-open .hamburger-menu-btn .hamburger-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
}

.mobile-nav-categories {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.mobile-category h5 {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--header-border);
    padding-bottom: 0.25rem;
}

.mobile-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
}

.mobile-links-grid a {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.6rem 0.8rem;
    background-color: var(--card-bg);
    border: 1px solid var(--header-border);
    border-radius: 8px;
    transition: all var(--transition-fast);
    text-align: center;
}

.mobile-links-grid a:hover {
    color: var(--accent-primary);
    background-color: var(--accent-soft);
    border-color: var(--accent-primary);
}

/* ============================
   Media Queries
   ============================ */
@media (max-width: 900px) {
    .header-nav {
        display: none !important; /* Hide desktop nav */
    }
    
    .hamburger-menu-btn {
        display: flex !important; /* Show hamburger */
    }
    
    .header-container {
        padding: 0.75rem 1rem;
        flex-wrap: nowrap;
    }

    .header-actions {
        gap: 0.5rem;
    }

    .stats-counter {
        display: none !important;
    }

    .lang-dropdown .curr-lang-text {
        display: none;
    }

    .lang-dropdown-trigger {
        padding: 0.4rem;
    }

    .logo-text {
        font-size: 1.25rem;
    }
}

/* ==========================================================================
   Global Search Bar component (My Local Picture)
   ========================================================================== */
.header-search {
    position: relative;
    width: 200px;
    transition: width var(--transition-normal);
}

.header-search:focus-within {
    width: 280px;
}

.search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.search-input-wrapper .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--text-muted);
    pointer-events: none;
    transition: color var(--transition-fast);
}

.global-search-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    background-color: var(--card-bg);
    border: 1px solid var(--header-border);
    padding: 0.5rem 2.2rem 0.5rem 2rem;
    border-radius: 10px;
    outline: none;
    transition: all var(--transition-normal);
}

.global-search-input:focus {
    background-color: var(--bg-primary);
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-soft);
}

.global-search-input:focus + .search-shortcut {
    opacity: 0;
    transform: scale(0.8);
}

.search-input-wrapper:hover .search-icon {
    color: var(--text-secondary);
}

.global-search-input:focus ~ .search-icon {
    color: var(--accent-primary);
}

.search-shortcut {
    position: absolute;
    right: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-primary);
    border: 1px solid var(--header-border);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    pointer-events: none;
    transition: all var(--transition-fast);
}

/* Dropdown de resultados de búsqueda */
.search-results-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 320px;
    background-color: var(--dropdown-bg);
    border: 1px solid var(--header-border);
    border-radius: 12px;
    box-shadow: var(--dropdown-shadow);
    padding: 0.5rem;
    max-height: 380px;
    overflow-y: auto;
    z-index: 110;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: slideDownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.search-results-dropdown.hidden {
    display: none;
}

.search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all var(--transition-fast);
    cursor: pointer;
}

.search-result-item svg {
    color: var(--text-muted);
    transition: color var(--transition-fast);
    flex-shrink: 0;
}

.search-result-item .result-info {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.search-result-item .result-name {
    color: var(--text-primary);
