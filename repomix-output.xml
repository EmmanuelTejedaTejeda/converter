    min-width: 0;
}

.watermark-canvas-container {
    position: relative;
    max-width: 100%;
    max-height: 65vh; /* Limits height so it doesn't overflow the screen */
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
    min-height: 0;
}

#editor-canvas {
    max-width: 100%;
    height: auto; /* Ensures it shrinks proportionally */
