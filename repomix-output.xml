                                        </td>
                                        <td>
                                            <span class="badge badge-prio"><xsl:value-of select="sitemap:priority"/></span>
                                        </td>
                                    </tr>
                                </xsl:for-each>
                            </tbody>
                        </table>
                    </div>
                </div>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
