# Sitemap header
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Apple App Site Association headers
/apple-app-site-association
  Content-Type: application/json; charset=utf-8
/.well-known/apple-app-site-association
  Content-Type: application/json; charset=utf-8

# Cache rules for assets (highly aggressive)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval';

# Evitar indexación en el subdominio de Cloudflare Pages y todas las previews
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive